VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free key from https://fdc.nal.usda.gov/api-key-signup.html — powers food
# database search (rice, oats, chicken, etc.) via the /api/usda-search proxy.
# Server-side only (NOT prefixed with VITE_) so it never ships to the browser.
# Leave unset to just use the AI estimate + Open Food Facts.
USDA_API_KEY=your-usda-key

# Server-side only — powers all AI features (coach, food scan, physique scan,
# workout plans) via the serverless functions in /api. NOT prefixed with VITE_
# so it never ships to the browser bundle. Add it in Vercel:
# Project Settings -> Environment Variables (all environments).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — org Admin key (sk-ant-admin01-...) for pulling your real Anthropic
# billing total into the spend screen. Only ORGANIZATION accounts have one;
# individual accounts can leave this unset and rely on the in-app estimate.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# ── Push reminders (OPTIONAL) ─────────────────────────────────────────────
# Generate a VAPID key pair once:  npx web-push generate-vapid-keys
# The PUBLIC key goes in BOTH places below (client build + server send).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# The reminder scheduler (api/send-reminders) reads all devices with the service
# role key, so add these server-side (NOT VITE_). Find them in Supabase:
# Project Settings -> API. Keep the service role key secret.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret so only your scheduler can trigger sends.
# CRON_SECRET=any-long-random-string
