VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free key from https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works for testing but is rate-limited (30 req/hour, 50/day)
VITE_USDA_API_KEY=DEMO_KEY

# Server-side only — powers the AI coach card via the /api/coach serverless
# function. NOT prefixed with VITE_ so it never ships to the browser bundle.
# Add it in Vercel: Project Settings -> Environment Variables (all environments).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
